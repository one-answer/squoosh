<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="192" height="192" viewBox="0 0 192 192" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- 精灵图标 -->
  <g transform="translate(16, 16) scale(0.32)">
    <!-- 背景圆 -->
    <circle cx="250" cy="250" r="250" fill="#40403F" stroke="#4A494A" stroke-width="10"/>
    
    <!-- 精灵身体 -->
    <path d="M250 100 C325 100, 375 175, 375 250 C375 350, 300 400, 200 400 C100 400, 25 350, 25 250 C25 175, 75 100, 150 100 Z" fill="#8BC34A" />
    
    <!-- 精灵翅膀 -->
    <path d="M175 150 C125 75, 50 100, 25 150 C75 125, 125 150, 175 150 Z" fill="#CDDC39" />
    <path d="M325 150 C375 75, 450 100, 475 150 C425 125, 375 150, 325 150 Z" fill="#CDDC39" />
    
    <!-- 精灵眼睛 -->
    <circle cx="175" cy="225" r="25" fill="white" />
    <circle cx="325" cy="225" r="25" fill="white" />
    <circle cx="175" cy="225" r="12" fill="black" />
    <circle cx="325" cy="225" r="12" fill="black" />
    
    <!-- 精灵嘴巴 -->
    <path d="M200 300 C225 325, 275 325, 300 300" stroke="black" stroke-width="8" fill="none" />
    
    <!-- 图片元素 -->
    <rect x="150" y="175" width="200" height="150" rx="12" fill="#FF5722" opacity="0.5" />
    <rect x="175" y="200" width="150" height="100" rx="8" fill="#FFC107" opacity="0.7" />
  </g>
</svg>
